<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store builds are sandboxed (SANDBOX=1 ./build-app.sh, packaging/release-mas.sh). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The Hugging Face cache and the library folder: the user picks them in an open panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Keep access to those two folders across launches (security-scoped bookmarks). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Redownloads: Hugging Face metadata and the LocalLM SDK's file downloads over HTTPS. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
